{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "Goi",
  "outputfilename": "goi",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Paul Fortin",
    "email": "pfortin@urbn.com"
  },
  "info": {
    "companyName": "Goi",
    "productName": "Goi",
    "productVersion": "0.1.1",
    "copyright": "Copyright \u00a9 2026 Goi contributors",
    "comments": "A cross-platform Go IDE",
    "fileAssociations": [
      {
        "ext": "go",
        "name": "Go Source",
        "description": "Go Source",
        "iconName": "appicon",
        "role": "Editor"
      },
      {
        "ext": "mod",
        "name": "Go Module",
        "description": "Go Module",
        "iconName": "appicon",
        "role": "Editor"
      },
      {
        "ext": "work",
        "name": "Go Workspace",
        "description": "Go Workspace",
        "iconName": "appicon",
        "role": "Editor"
      },
      {
        "ext": "gotmpl",
        "name": "Go Template",
        "description": "Go Template",
        "iconName": "appicon",
        "role": "Editor"
      },
      {
        "ext": "tmpl",
        "name": "Go Template",
        "description": "Go Template",
        "iconName": "appicon",
        "role": "Editor"
      }
    ]
  }
}
